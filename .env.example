# HER POV — Stripe + SendOwl launch checks (no until verified)
# These belong in Render Environment, not GitHub.
PUBLIC_BASE_URL=https://her-pov-preview.onrender.com
STRIPE_MODE=test
SENDOWL_PRODUCT_LINKED=no
SENDOWL_ALL_PRODUCTS_LINKED=no
SENDOWL_DELIVERY_TESTED=no
SENDOWL_BUNDLE_TESTED=no
STRIPE_PAYOUTS_CONFIRMED=no
MERCHANT_POLICIES_APPROVED=no
MERCHANT_TAX_REVIEWED=no
LIVE_READY=no
# Set only after the $29.90 Stripe Payment Link has been created inactive and delivery tested.
BUNDLE_PAYMENT_LINK_URL=
# Owner-only credentials remain stored in Render:
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only needed for dormant legacy in-house fulfillment:
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
DOWNLOAD_SIGNING_SECRET=
# R2/S3 and Resend NOT NEEDED when using SendOwl.
